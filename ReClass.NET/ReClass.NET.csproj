<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ReClassNET</RootNamespace>
    <AssemblyName>ReClass.NET</AssemblyName>
    <ApplicationIcon>Resources\Icon\ReClassNet.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- The app is built once per bitness because pointer sizes are compile-time constants. -->
    <Platforms>x86;x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>

    <!-- Keep the Framework-era look: .NET changed the default font to Segoe UI 9pt. -->
    <ApplicationDefaultFont>Microsoft Sans Serif, 8.25pt</ApplicationDefaultFont>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>

    <!-- NativeCore.dll is built into the same folder, so keep the layout free of TFM/RID subfolders. -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <OutputPath>$(RepoRoot)bin\$(Configuration)\$(Platform)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!-- The solution lists the launcher and NativeCore as build dependencies only; don't copy their outputs here. -->
    <AddSyntheticProjectReferencesForSolutionDependencies>false</AddSyntheticProjectReferencesForSolutionDependencies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <DefineConstants>$(DefineConstants);RECLASSNET64</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>$(DefineConstants);RELEASE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ColorCode">
      <HintPath>..\Dependencies\ColorCode.dll</HintPath>
    </Reference>
    <Reference Include="Dia2Lib">
      <HintPath>..\Dependencies\Dia2Lib.dll</HintPath>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.ExceptionMessageBox">
      <HintPath>..\Dependencies\Microsoft.ExceptionMessageBox.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Source files that exist on disk but were never part of the build. -->
  <ItemGroup>
    <Compile Remove="AddressParser\AstBuilder.cs" />
    <Compile Remove="AddressParser\Operations.cs" />
    <Compile Remove="Forms\ProcessMemoryViewForm.cs" />
    <Compile Remove="Forms\ProcessMemoryViewForm.Designer.cs" />
    <Compile Remove="Nodes\ClassInstanceArrayNode.cs" />
    <Compile Remove="Nodes\FunctionNode.Tokenizer.cs" />
    <EmbeddedResource Remove="Forms\ProcessMemoryViewForm.resx" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Resources.resx embeds this file to show the build date in the about dialog. -->
  <Target Name="WriteBuildDate" BeforeTargets="PrepareForBuild">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Resources\BuildDate.txt" Lines="$([System.DateTime]::UtcNow.ToString('yyyy\/MM\/dd HH\:mm\:ss'))" Overwrite="true" Encoding="Unicode" />
  </Target>

</Project>
